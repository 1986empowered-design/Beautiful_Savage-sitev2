<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="manifest" href="manifest.json">
    <title>Sacred Gallery | Beautiful Savage</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #121212;
            color: #f1f1f1;
            margin: 0;
            padding: 20px;
        }
        header {
            text-align: center;
            margin-bottom: 30px;
        }
        h1 {
            color: #e67e22;
            margin-bottom: 5px;
        }
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            max-width: 1000px;
            margin: 0 auto;
        }
        .card {
            background: #1e1e1e;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
            text-align: center;
            padding-bottom: 15px;
        }
        .card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
        }
        .card h3 {
            margin: 15px 0 5px;
        }
        .card p {
            color: #aaa;
            padding: 0 15px;
            font-size: 14px;
        }
        .btn {
            display: inline-block;
            margin-top: 10px;
            background-color: #e67e22;
            color: white;
            padding: 8px 16px;
            text-decoration: none;
            border-radius: 4px;
            font-weight: bold;
        }
        .nav-links {
            text-align: center;
            margin-top: 30px;
        }
        .nav-links a {
            color: #3498db;
            text-decoration: none;
            margin: 0 10px;
        }
    </style>
</head>
<body>

    <header>
        <h1>Sacred Gallery</h1>
        <p>Original paintings, fine art prints, and custom commissions.</p>
    </header>

    <div class="gallery-grid">
        <div class="card">
            <!-- Replace with your image link -->
            <img src="placeholder.jpg" alt="Artwork 1">
            <h3>Prime Heritage</h3>
            <p>Original acrylic on canvas study exploring modern grit.</p>
            <a href="#" class="btn">Inquire / Buy</a>
        </div>
        
        <div class="card">
            <!-- Replace with your image link -->
            <img src="placeholder.jpg" alt="Artwork 2">
            <h3>Industrial Echo</h3>
            <p>High-resolution fine art print on archival paper.</p>
            <a href="#" class="btn">Order Print</a>
        </div>
    </div>

    <div class="nav-links">
        <a href="index.html">Home</a>
        <a href="store.html">Storefront</a>
    </div>

</body>
</html>

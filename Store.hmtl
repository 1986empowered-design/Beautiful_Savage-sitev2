<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sacred Storefront | Beautiful Savage</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;900&family=Orbitron:wght@500;700&family=Space+Mono&display=swap" rel="stylesheet">
    <style>
        :root {
            --void-black: #050505;
            --deep-purple: #1a0a2e;
            --gold-primary: #d4af37;
            --gold-light: #f9e076;
            --teal-accent: #0d9488;
            --starlight: #e0e0e0;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: var(--void-black);
            color: var(--starlight);
            font-family: 'Space Mono', monospace;
            min-height: 100vh;
            padding-bottom: 60px;
        }

        nav {
            padding: 20px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(5,5,5,0.9);
            border-bottom: 1px solid rgba(212,175,55,0.2);
            position: sticky; top: 0; z-index: 100;
        }

        .brand {
            font-family: 'Cinzel', serif;
            font-size: 1.1rem;
            color: var(--gold-primary);
            text-decoration: none;
            letter-spacing: 2px;
        }

        .nav-links a {
            color: var(--starlight);
            text-decoration: none;
            font-size: 0.75rem;
            margin-left: 15px;
            font-family: 'Orbitron', sans-serif;
        }

        header {
            text-align: center;
            padding: 60px 20px 30px;
        }

        h1 {
            font-family: 'Cinzel', serif;
            font-size: clamp(2rem, 5vw, 3.2rem);
            color: var(--gold-primary);
            letter-spacing: 3px;
            margin-bottom: 8px;
        }

        p.sub {
            font-size: 0.8rem;
            color: var(--teal-accent);
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .store-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            margin-top: 30px;
        }

        /* Product Card */
        .store-card {
            background: rgba(26,10,46,0.4);
            border: 1px solid rgba(212,175,55,0.25);
            border-radius: 8px;
            padding: 25px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .store-card:hover {
            border-color: var(--gold-primary);
            box-shadow: 0 0 20px rgba(212,175,55,0.15);
        }

        .badge-featured {
            position: absolute;
            top: 15px; right: 15px;
            background: rgba(212,175,55,0.2);
            border: 1px solid var(--gold-primary);
            color: var(--gold-light);
            font-size: 0.6rem;
            font-family: 'Orbitron', sans-serif;
            padding: 4px 8px;
            border-radius: 3px;
        }

        .card-title {
            font-family: 'Cinzel', serif;
            font-size: 1.3rem;
            color: var(--gold-light);
            margin-bottom: 10px;
            padding-right: 60px;
        }

        .card-desc {
            font-size: 0.8rem;
            color: rgba(224,224,224,0.75);
            line-height: 1.5;
            margin-bottom: 20px;
        }

        .price-tag {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.2rem;
            color: var(--gold-primary);
        }

        .btn-buy {
            padding: 10px 18px;
            background: linear-gradient(135deg, rgba(212,175,55,0.2), rgba(74,20,140,0.4));
            border: 1px solid var(--gold-primary);
            color: var(--gold-light);
            font-family: 'Orbitron', sans-serif;
            font-size: 0.7rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            text-decoration: none;
            border-radius: 4px;
            display: inline-block;
            text-align: center;
        }

        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: auto;
            padding-top: 15px;
            border-top: 1px solid rgba(212,175,55,0.15);
        }

        /* Coming Soon Locked Overlay */
        .store-card.locked {
            border-color: rgba(13,148,136,0.3);
            opacity: 0.85;
        }

        .locked-overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(5,5,5,0.75);
            backdrop-filter: blur(4px);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 20px;
        }

        .lock-icon {
            font-size: 2rem;
            color: var(--teal-accent);
            margin-bottom: 8px;
        }

        .lock-text {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            color: var(--teal-accent);
            letter-spacing: 2px;
            text-transform: uppercase;
        }
    </style>
</head>
<body>

    <nav>
        <a href="index.html" class="brand">BEAUTIFUL SAVAGE</a>
        <div class="nav-links">
            <a href="index.html">Home</a>
            <a href="breath_trainer.html">Breathwork</a>
            <a href="gallery.html">Gallery</a>
        </div>
    </nav>

    <header>
        <h1>Flagship Offerings</h1>
        <p class="sub">Curated Digital Transmissions & Courses</p>
    </header>

    <div class="container">
        <div class="store-grid">
            
            <!-- Active Flagship 1 -->
            <div class="store-card">
                <span class="badge-featured">FEATURED</span>
                <h3 class="card-title">Inner Sanctum Mastery</h3>
                <p class="card-desc">The complete quantum realignment program designed to recalibrate energy fields, overcome subconscious blocks, and activate sovereignty.</p>
                <div class="card-footer">
                    <span class="price-tag">$197</span>
                    <a href="https://paypal.me/beautifulsavage/197" target="_blank" class="btn-buy">Acquire Access</a>
                </div>
            </div>

            <!-- Active Flagship 2 -->
            <div class="store-card">
                <h3 class="card-title">Quantum Heart Activation</h3>
                <p class="card-desc">7 guided frequency modules and heart-field clearing exercises built to deepen magnetic attraction and emotional alignment.</p>
                <div class="card-footer">
                    <span class="price-tag">$147</span>
                    <a href="https://paypal.me/beautifulsavage/147" target="_blank" class="btn-buy">Acquire Access</a>
                </div>
            </div>

            <!-- "Coming Soon" Teaser Lock 1 -->
            <div class="store-card locked">
                <h3 class="card-title">Sacred Geometry Codex</h3>
                <p class="card-desc">An immersive masterclass breaking down signature energy patterns, visual frequencies, and physical manifestation mechanics.</p>
                <div class="card-footer">
                    <span class="price-tag">$297</span>
                    <span class="btn-buy" style="opacity:0.5;">Locked</span>
                </div>
                <div class="locked-overlay">
                    <div class="lock-icon">🔒</div>
                    <div class="lock-text">TRANSMISSION LOCKED</div>
                    <p style="font-size:0.65rem; color:rgba(224,224,224,0.6); margin-top:5px;">Releasing Next Solar Cycle</p>
                </div>
            </div>

            <!-- "Coming Soon" Teaser Lock 2 -->
            <div class="store-card locked">
                <h3 class="card-title">The Sovereign Artist Mastermind</h3>
                <p class="card-desc">A step-by-step blueprint for creative entrepreneurs building digital product ecosystems and fine art businesses on mobile.</p>
                <div class="card-footer">
                    <span class="price-tag">$497</span>
                    <span class="btn-buy" style="opacity:0.5;">Locked</span>
                </div>
                <div class="locked-overlay">
                    <div class="lock-icon">🔒</div>
                    <div class="lock-text">COMING SOON</div>
                    <p style="font-size:0.65rem; color:rgba(224,224,224,0.6); margin-top:5px;">Vault Opening Shortly</p>
                </div>
            </div>

        </div>
    </div>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="manifest" href="manifest.json">
    <title>Storefront | Beautiful Savage</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #121212;
            color: #f1f1f1;
            margin: 0;
            padding: 20px;
        }
        header {
            text-align: center;
            margin-bottom: 30px;
        }
        h1 {
            color: #2ecc71;
            margin-bottom: 5px;
        }
        .store-container {
            max-width: 800px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        .product-row {
            background: #1e1e1e;
            padding: 20px;
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            border-left: 5px solid #2ecc71;
        }
        .product-row.locked {
            border-left-color: #7f8c8d;
            opacity: 0.7;
        }
        .product-row h3 {
            margin: 0;
        }
        .product-row p {
            margin: 0;
            color: #aaa;
            font-size: 14px;
        }
        .action-btn {
            align-self: flex-start;
            background-color: #2ecc71;
            color: white;
            padding: 8px 16px;
            text-decoration: none;
            border-radius: 4px;
            font-weight: bold;
            font-size: 14px;
        }
        .locked-tag {
            color: #e74c3c;
            font-weight: bold;
            font-size: 14px;
        }
        .nav-links {
            text-align: center;
            margin-top: 30px;
        }
        .nav-links a {
            color: #3498db;
            text-decoration: none;
            margin: 0 10px;
        }
    </style>
</head>
<body>

    <header>
        <h1>Flagship Store</h1>
        <p>Curated digital products, courses, and resources.</p>
    </header>

    <div class="store-container">
        <!-- Active Product -->
        <div class="product-row">
            <h3>Master Blueprint (Digital Guide)</h3>
            <p>Immediate download, full step-by-step PDF workbook and video bundle.</p>
            <!-- Replace href with your payment link -->
            <a href="#" class="action-btn">Get Instant Access</a>
        </div>

        <!-- Locked / Coming Soon Product -->
        <div class="product-row locked">
            <h3>Advanced Techniques Masterclass</h3>
            <p>Extended video course covering deep setup strategies.</p>
            <span class="locked-tag">🔒 Coming Soon</span>
        </div>
    </div>

    <div class="nav-links">
        <a href="index.html">Home</a>
        <a href="gallery.html">Sacred Gallery</a>
    </div>

</body>
</html>
